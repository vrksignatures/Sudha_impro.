<?xml version="1.0" encoding="utf-8"?>
<!-- The whole palette: paper, ink, one brand colour (the navy of Aakriti's avatar), three signals.
     The same values are named in MagicUi.java. -->
<resources>
    <color name="bg">#F6F7FB</color>
    <color name="surface">#FFFFFF</color>
    <color name="line">#E4E6EF</color>
    <color name="text">#10122B</color>
    <color name="muted">#62677D</color>
    <color name="faint">#9BA1B5</color>
    <color name="brand">#1B0F7A</color>
    <color name="brand_soft">#EEEDFA</color>
    <color name="good">#0E9F6E</color>
    <color name="warn">#D9822B</color>
    <color name="bad">#D63B4B</color>
    <!-- The folded panel's ring: a dark hairline and a light one, both see-through. -->
    <color name="ring_shade">#66000000</color>
    <color name="ring_light">#D9FFFFFF</color>
    <!-- Boxes and quiet buttons on the open panel: white glass (the controller sets how see-through). -->
    <color name="glass_surface">#BDFFFFFF</color>
</resources>
