    <!-- Accessibility service -->
    <string name="accessibility_service_label">SudhaAutoBot</string>
    <string name="accessibility_service_description">Automates the daily order-entry task in the Sudha Daily Orders app. It only reads and taps screens inside the package you configure, keeps a per-day ledger of processed retailers, and never submits the same order twice. It requires no network access.</string>

    <!-- Main screen -->
    <string name="setup_title">SudhaAutoBot</string>
    <string name="setup_intro">Configure the Sudha Daily Orders package, grant both permissions, then start the daily batch from the floating panel. Progress is saved per day, so a pause or restart never repeats a retailer.</string>
