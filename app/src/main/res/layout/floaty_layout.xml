<?xml version="1.0" encoding="utf-8"?>
<!--
  The floating panel. Inflated by FloatingPanelController and added to the WindowManager as
  a TYPE_APPLICATION_OVERLAY window.

  Two faces.

  FOLDED it is a ring and nothing else (panel_mini): no fill, no picture, no word. The
  wallpaper or the app behind shows through it untouched; two hairlines, one dark and one
  light, are all that say "something is here". A TAP on the ring opens the dashboard, a
  drag moves it. Pressing Start folds the panel by itself.

  OPEN it is the dashboard below, on a sheet of white glass: the app behind stays visible
  through it. How see-through is a setting (Glass.java); the words are never thinned - the
  controller gives each one a pale edge so that it reads over whatever is behind. A tap
  on the top strip folds it again.

  The dashboard, top to bottom:
    1. The avatar + status light, the name and the mood; under them the bot's state and
       the retailer in hand. The whole strip is the drag handle; a tap folds the panel.
    2. A progress line with "done / total".
    3. The three counts; on the right, the chat button and Lock song (tap: lock / unlock
       the song being heard; long press: which song it is).
    3a. Sound: Play / Pause, what is being heard, and the Songs / Auto-Dialogues button.
    4. What the bot is doing, in words.
    4a. The question box and the answer above it. Like row 5 it is there only while the
        bot is NOT running: a window that takes the keyboard would take the screen away
        from the Sudha app in the middle of an order.
    5. "Last done ID" - shown only while the bot is NOT running. Type 2244 and Start
       carries on with the retailer after SMR2244. It belongs to today's date only.
    6. Start / Pause, Reset, Capture, Hide.

  Constraints:
  * No ConstraintLayout, no Material components - framework widgets only.
  * No name or mark of the maker anywhere on it.
  * Silent: the controller switches the tap sound off for every view in here.
  * Every visible string comes from strings.xml; every colour from colors.xml.
  * The drag handle strip is the only touch target that moves the open window.
  * While the bot runs the panel is as wide as the one it replaces (the message still sets
    the width at 260dp); row 5 is hidden. The bot never assumes a size: it asks the
    controller where the window is (boundsOnScreen) each time it plans a touch.
  * Ids the controller reads: panel_root, panel_drag_handle, panel_avatar, panel_status_dot,
    panel_mood, panel_state, panel_current, panel_body, panel_bar, panel_progress,
    panel_counts, panel_chat, panel_song, panel_message, panel_start_row, panel_last_done,
    panel_last_done_note, panel_start_pause, panel_reset, panel_capture, panel_hide,
    panel_mini, panel_mini_art, panel_music_row, panel_mini_title, panel_mini_wave,
    panel_mini_sub, panel_mini_play, panel_lines, panel_ask_row, panel_ask, panel_answer.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="4dp">

    <!-- Folded: a ring and nothing else. A tap opens the dashboard; a drag moves it. -->
    <FrameLayout
        android:id="@+id/panel_mini"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:visibility="gone">

        <View
            android:id="@+id/panel_mini_art"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="@drawable/mini_ring"
            android:contentDescription="@string/cd_mini_art" />
    </FrameLayout>

    <!-- 1. The name, the mood, the state. The whole strip is draggable. -->
    <LinearLayout
        android:id="@+id/panel_drag_handle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp">

            <ImageView
                android:id="@+id/panel_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/panel_avatar_ring"
                android:contentDescription="@string/aakriti_name"
                android:scaleType="fitCenter"
                android:src="@drawable/aakriti" />

            <!-- A white rim, and inside it the light: green at work, amber paused, red stopped. -->
            <FrameLayout
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/panel_avatar_ring">

                <View
                    android:id="@+id/panel_status_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="center"
                    android:background="@drawable/panel_status_dot" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="@string/aakriti_name"
                    android:textColor="@color/text"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/panel_mood"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/mood_idle"
                    android:textColor="@color/muted"
                    android:textSize="10sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/panel_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.03"
                    android:maxLines="1"
                    android:text="@string/state_idle"
                    android:textColor="@color/brand"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/panel_current"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/panel_retailer_none"
                    android:textColor="@color/text"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Conditional High-Volume STOP ALARM button (shown only during ALARM_HALTED) -->
        <Button
            android:id="@+id/panel_stop_alarm"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginBottom="6dp"
            android:background="#DC2626"
            android:fontFamily="sans-serif-medium"
            android:text="STOP ALARM"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 2. Progress. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/panel_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:indeterminate="false"
                android:max="1000"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:progress="0"
                android:progressDrawable="@drawable/panel_progress" />

            <TextView
                android:id="@+id/panel_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="@string/panel_progress_zero"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 3. The counts; Ask Aakriti; Lock song. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/panel_counts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/panel_counts_zero"
                android:textColor="@color/text"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/panel_chat"
                android:layout_width="36dp"
                android:layout_height="34dp"
                android:background="@drawable/panel_icon_button"
                android:contentDescription="@string/cd_chat"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chat"
                android:tint="@color/muted" />

            <ImageButton
                android:id="@+id/panel_song"
                android:layout_width="36dp"
                android:layout_height="34dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/panel_icon_button"
                android:contentDescription="@string/cd_song"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_song"
                android:tint="@color/muted" />
        </LinearLayout>

        <!-- 3a. Sound: Play / Pause, what is being heard, and Songs or Auto-Dialogues. -->
        <LinearLayout
            android:id="@+id/panel_music_row"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/panel_mini_play"
                android:layout_width="36dp"
                android:layout_height="34dp"
                android:background="@drawable/panel_icon_button"
                android:contentDescription="@string/cd_mini_play"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                android:tint="@color/brand" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/panel_mini_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:text="@string/mini_idle"
                    android:textColor="@color/text"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/panel_mini_wave"
                        android:layout_width="20dp"
                        android:layout_height="10dp" />

                    <TextView
                        android:id="@+id/panel_mini_sub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/mini_sub"
                        android:textColor="@color/muted"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/panel_lines"
                android:layout_width="36dp"
                android:layout_height="34dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/panel_icon_button"
                android:contentDescription="@string/cd_lines"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_lines"
                android:tint="@color/muted" />
        </LinearLayout>

        <!-- 4. What the bot is doing. Sets the width of the panel. -->
        <TextView
            android:id="@+id/panel_message"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:text="@string/panel_ready"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <!-- 4a. Ask Aakriti. Only while the bot is not running. -->
        <LinearLayout
            android:id="@+id/panel_ask_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/panel_answer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:includeFontPadding="false"
                android:lineSpacingExtra="1dp"
                android:maxLines="8"
                android:textColor="@color/text"
                android:textSize="11sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/panel_ask"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:background="@drawable/panel_field"
                android:hint="@string/panel_ask_hint"
                android:imeOptions="actionSend|flagNoExtractUi|flagNoFullscreen"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLength="80"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/text"
                android:textColorHint="@color/faint"
                android:textCursorDrawable="@null"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 5. Last done ID. Only while the bot is not running. -->
        <LinearLayout
            android:id="@+id/panel_start_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:labelFor="@+id/panel_last_done"
                android:text="@string/panel_last_done_label"
                android:textColor="@color/text"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/panel_last_done"
                android:layout_width="78dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/panel_field"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:hint="@string/panel_last_done_hint"
                android:imeOptions="actionDone|flagNoExtractUi|flagNoFullscreen"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="6"
                android:maxLines="1"
                android:padding="0dp"
                android:textColor="@color/text"
                android:textColorHint="@color/faint"
                android:textCursorDrawable="@null"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/panel_last_done_note"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="@string/start_note_empty"
                android:textColor="@color/muted"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 6. One filled button, three quiet ones. 44dp to the touch, 36dp to the eye. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/panel_start_pause"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.7"
                android:background="@drawable/panel_pill_start"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="@string/action_start"
                android:textAllCaps="false"
                android:textColor="@color/surface"
                android:textSize="13sp" />

            <Button
                android:id="@+id/panel_reset"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/panel_pill_ghost"
                android:fontFamily="sans-serif-medium"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="@string/action_reset"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/panel_capture"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="0.7"
                android:background="@drawable/panel_pill_ghost"
                android:contentDescription="@string/cd_capture"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_capture"
                android:tint="@color/muted" />

            <ImageButton
                android:id="@+id/panel_hide"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="0.7"
                android:background="@drawable/panel_pill_ghost"
                android:contentDescription="@string/cd_hide"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                android:tint="@color/muted" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
