<?xml version="1.0" encoding="utf-8"?>
<!--
  Floating control panel. Inflated by FloatingPanelController and added to the
  WindowManager as a TYPE_APPLICATION_OVERLAY window.

  Design constraints:
  * No AndroidX, no ConstraintLayout, no Material components - framework widgets only.
  * Every visible string comes from strings.xml.
  * The drag handle strip is the only touch target that moves the window.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="4dp">

    <!-- Collapsed summary line; the whole strip is draggable. -->
    <LinearLayout
        android:id="@+id/panel_drag_handle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/panel_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/state_idle"
            android:textColor="#4FC3F7"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/panel_current"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/panel_retailer_none"
            android:textColor="#E0E0E0"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/panel_drag_hint"
            android:textColor="#757575"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/panel_counts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/panel_counts_zero"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/panel_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/panel_progress_zero"
            android:textColor="#9E9E9E"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/panel_message"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="3"
            android:text="@string/panel_ready"
            android:textColor="#B0BEC5"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/panel_start_pause"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1.4"
                android:backgroundTint="#2E7D32"
                android:text="@string/action_start"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/panel_reset"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#455A64"
                android:text="@string/action_reset"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/panel_capture"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="0.8"
                android:backgroundTint="#37474F"
                android:text="@string/action_capture"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/panel_hide"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="0.8"
                android:backgroundTint="#37474F"
                android:text="@string/action_hide"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/panel_fast_mode"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#455A64"
            android:text="@string/action_fast_off"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
